# Put the API behind the same host the mod is pointed at:
#   https://pokewing.com/api/cosmetic.json
server {
    listen 443 ssl http2;
    server_name pokewing.com;

    # ssl_certificate / ssl_certificate_key: your existing certificate.

    location /api/ {
        proxy_pass         http://127.0.0.1:8080;
        proxy_set_header   Host $host;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Model uploads are up to 25 MB.
        client_max_body_size 32m;
        proxy_read_timeout 120s;
    }

    # The rest of the site carries on as before.
}
